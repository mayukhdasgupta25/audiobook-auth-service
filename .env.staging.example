# Staging Environment Variables Template
# Copy to .env.staging on the staging server and replace placeholders with real values.
# localhost and 127.0.0.1 are not allowed in staging.

NODE_ENV=staging
PORT=8080

# Reverse proxy (Express trust proxy hop count)
# Number of trusted reverse-proxy hops in front of this service (e.g. nginx).
# Use 0 when hitting Node directly (local dev). Use 1 for a single nginx/LB hop.
# Required for express-rate-limit to honor X-Forwarded-For and for secure cookies behind HTTPS.
TRUST_PROXY=1

HEALTH_SUPPORT_EMAIL=no-reply@srota-support.com
HEALTH_SUPPORT_PASSWORD=

DATABASE_URL=postgresql://user:password@db.staging.internal:5432/auth_service
SUBSCRIPTION_CURRENCY=INR
REDIS_URL=redis://redis.staging.internal:6379
RABBITMQ_URL=amqp://user:password@rabbitmq.staging.internal:5672
RABBITMQ_EXCHANGE=users
RABBITMQ_AUTHORS_EXCHANGE=authors

JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=auth-service-staging-key
JWT_ISSUER=auth-service-staging
JWT_ACCESS_TOKEN_EXPIRY=7d
JWT_REFRESH_TOKEN_EXPIRY=7d

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

EMAIL_FROM=noreply@staging.example.com
EMAIL_SERVICE_URL=https://email.staging.internal

GOOGLE_CLIENT_ID=

ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4

# File uploads (same S3 bucket as app-service)
MAX_FILE_SIZE=52428800
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
AWS_SIGNED_URL_EXPIRES_IN=3600

LOG_LEVEL=info

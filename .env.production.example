# Production Environment Variables Template
# Copy to .env.production on the production server and replace placeholders with real values.
# localhost and 127.0.0.1 are not allowed in production.

NODE_ENV=production
PORT=8080

DATABASE_URL=postgresql://user:password@db.production.internal:5432/auth_service
SUBSCRIPTION_CURRENCY=INR
REDIS_URL=redis://redis.production.internal:6379
RABBITMQ_URL=amqp://user:password@rabbitmq.production.internal:5672
RABBITMQ_EXCHANGE=users

JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=auth-service-production-key
JWT_ISSUER=auth-service
JWT_ACCESS_TOKEN_EXPIRY=7d
JWT_REFRESH_TOKEN_EXPIRY=7d

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

EMAIL_FROM=noreply@example.com
EMAIL_SERVICE_URL=https://email.production.internal

GOOGLE_CLIENT_ID=

ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4

LOG_LEVEL=info

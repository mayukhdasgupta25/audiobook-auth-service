# Testing server environment (deployed test environment)
# Copy to .env.testing on the test server. localhost is allowed.
# NODE_ENV=testing is separate from Jest (NODE_ENV=test).

NODE_ENV=testing
PORT=8080

# Reverse proxy (Express trust proxy hop count)
# Number of trusted reverse-proxy hops in front of this service (e.g. nginx).
# Use 0 when hitting Node directly (local dev). Use 1 for a single nginx/LB hop.
# Required for express-rate-limit to honor X-Forwarded-For and for secure cookies behind HTTPS.
TRUST_PROXY=1

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth_service
SUBSCRIPTION_CURRENCY=INR

REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_EXCHANGE=users

JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=auth-service-testing-key
JWT_ISSUER=auth-service-testing
JWT_ACCESS_TOKEN_EXPIRY=7d
JWT_REFRESH_TOKEN_EXPIRY=7d

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

EMAIL_FROM=test@audiobook.com
EMAIL_SERVICE_URL=

GOOGLE_CLIENT_ID=

ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4

LOG_LEVEL=info
